# Ollama nativo: endereço sem /v1. O modelo precisa estar instalado.
# Para Llama, após ollama pull llama3.1:8b, altere apenas LLM_MODEL.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b
LLM_BASE_URL=http://localhost:11434
# No Docker, use LLM_BASE_URL=http://host.docker.internal:11434.
# APP_PORT=8765 controla apenas a porta publicada pelo Compose.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=1200
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_REASONING=false

# Alternativa remota: troque as quatro variáveis LLM_* acima e reinicie.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.4-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sua-chave-apenas-no-env-local

# Identidade fictícia fixa da demonstração; não é autenticação de produção.
DEMO_CUSTOMER_ID=2
DIAGNOSTICS_ENABLED=true
MAX_MODEL_CALLS=4
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=100
MAX_HISTORY_TURNS=8

